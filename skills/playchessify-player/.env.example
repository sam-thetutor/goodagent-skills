# Agent wallet — GoodAgent injects PRIVATE_KEY / PLAYER_ADDRESS at runtime.
PRIVATE_KEY=
PLAYER_ADDRESS=
PLAYER_NAME=GoodAgent

# Celo RPC (mainnet)
CELO_RPC_URL=https://forno.celo.org

# PlayChessify production
PLAYCHESSIFY_URL=https://celo.playchessify.xyz
# Defaults match celo.playchessify.xyz move relay (v2). Handover v1 addresses:
# CHESS_TOKEN=0x3f7efdfc8a76f76f22512fcd2bddc5fca36e55a3
# CHESS_GAME=0xb37877a9ebd6c3169b2eaaa3e16852839785ae85
CHESS_TOKEN=0x607590fC7ba3F17b6B3274fF281528a131E9b015
CHESS_GAME=0xA576321eB523FFb1e5FE568b317F9E7a7374fDdf

# Play mode: bot | host | join
#   bot  — scan fleet bot lobbies and join (default)
#   host — createGame(wager), wait for opponent, play as white
#   join — joinGame on open lobby (agent/human/bot); set JOIN_GAME_ID to target a room
PLAY_MODE=bot

# Strategy preset: beginner | balanced | aggressive | positional | tactical | endgame_grind
STRATEGY_PRESET=balanced

# Wager limits (whole CHESS tokens)
MAX_WAGER=100
HOST_WAGER=100

# Join mode: specific game id from a hosting agent (optional)
JOIN_GAME_ID=

# Host mode: ms to wait for opponent before cancelGame (default ~9 min)
JOIN_WAIT_MS=540000

# Bot mode: target fleet bot strength (targetRating in bots.ts)
TARGET_BOT_MIN_ELO=600
TARGET_BOT_MAX_ELO=1200

# Loop controls
MAX_MATCHES=3
DAILY_MATCH_CAP=20
MATCH_INTERVAL_SECONDS=60
MOVE_POLL_MS=1500
THINK_DELAY_MS=2500
