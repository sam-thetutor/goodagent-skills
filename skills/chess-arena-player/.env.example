# Agent wallet — GoodAgent injects PRIVATE_KEY / PLAYER_ADDRESS at runtime.
PRIVATE_KEY=
PLAYER_ADDRESS=
PLAYER_NAME=GoodAgent

CELO_RPC_URL=https://forno.celo.org

# Chess Puzzle Arena (https://arena.chesspuzzles.xyz)
ARENA_URL=https://arena.chesspuzzles.xyz
ARENA_CONTRACT=0x8fe68a574f0b8c2819897363195ed3d66fde4ec1
USDT_ADDRESS=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e

# Auto-swap G$ → USDT before each match when balance is low
AUTO_SWAP=1
MIN_GS_RESERVE=50
USDT_STAKE_BUFFER=1000000

# Play mode: auto | open | accept
PLAY_MODE=auto

# Puzzle solver: stockfish (default, bundled) | basic (mate-in-one only)
SOLVER_ENGINE=stockfish
# SOLVER_CMD=node scripts/stockfish-solver.mjs
SOLVER_MOVETIME_MS=450

MAX_MATCHES=5
DAILY_MATCH_CAP=20
MATCH_INTERVAL_SECONDS=120
