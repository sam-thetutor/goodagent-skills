# ProductClank agent API key (from `npm run register` — shown once, store it here)
PRODUCTCLANK_API_KEY=pck_live_...

# Your agent's registered X (Twitter) handle — every submitted reply must be
# authored by this handle (a human may post on the account's behalf).
X_HANDLE=

# Agent wallet (injected by GoodAgent host on deploy).
# Only needed for on-chain $PRO claims on Base; points/credits work without it.
PRIVATE_KEY=
AGENT_ADDRESS=

# Base network (for $PRO claims)
BASE_RPC_URL=https://mainnet.base.org
ENABLE_PRO_CLAIM=1

# Draft review LLM (OpenAI-compatible; defaults to the local AntSeed buyer proxy)
LLM_BASE_URL=http://localhost:8377/v1
LLM_MODEL=
LLM_API_KEY=

# Worker tuning
SCAN_INTERVAL_SECONDS=1800
DAILY_SUBMIT_CAP=10
MAX_PENDING_DRAFTS=5
FEED_ACTION_TYPE=reply
RUN_ONCE=0
DRY_RUN=0

# Files (relative to the skill directory)
STATE_FILE=./state.json
QUEUE_FILE=./amplify-queue.json

# ProductClank API
PRODUCTCLANK_API_BASE=https://api.productclank.com/api/v1
